<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:fillViewport="true"
    tools:context=".RegistrationActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            app:lottie_autoPlay="true"
            app:lottie_rawRes="@raw/register"
            app:lottie_loop="true" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="35dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registration Form"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:layout_marginBottom="15dp"/>

                <EditText
                    android:id="@+id/etRegistrationName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:hint="Name"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:inputType="textPersonName"
                    android:drawableLeft="@drawable/account"
                    android:drawablePadding="8dp"
                    />

                <EditText
                    android:id="@+id/etRegistrationMobNumber"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:hint="Mobile Number"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:inputType="number"
                    android:maxLength="10"
                    android:drawableLeft="@drawable/call_icon"
                    android:drawablePadding="8dp"/>

                <EditText
                    android:id="@+id/etRegistrationEmailId"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:hint="Email Id"
                    android:textColor="#000000"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:inputType="textEmailAddress"
                    android:drawableLeft="@drawable/email"
                    android:drawablePadding="8dp"/>

                <EditText
                    android:id="@+id/etRegistrationUsername"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:hint="UserName"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:inputType="textPersonName"
                    android:drawableLeft="@drawable/account"
                    android:drawablePadding="8dp"/>

                <EditText
                    android:id="@+id/etRegistrationPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:hint="Password"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:inputType="textPassword"
                    android:drawableLeft="@drawable/lock"
                    android:drawablePadding="8dp"/>

                <EditText
                    android:id="@+id/etRegistrationConformPassword"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_margin="8dp"
                    android:hint="Conform Password"
                    android:textColor="@color/black"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:padding="10dp"
                    android:inputType="textPassword"
                    android:drawableLeft="@drawable/lock_check"
                    android:drawablePadding="8dp"/>

                <CheckBox
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/cbRegistrationShowHidePassword"
                    android:text="Show Password"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginLeft="16sp"
                    android:layout_marginRight="16sp"
                    android:buttonTint="@color/blue"
                    />

                <Button
                    android:id="@+id/btnRegistrationRegister"
                    android:layout_width="200dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="15dp"
                    android:text="Register"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif"
                    android:backgroundTint="#0047FF"/>



            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>
