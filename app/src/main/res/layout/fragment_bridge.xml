<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bridge"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Turn words into meaningful signs"
                    android:textColor="#9CA9C7"
                    android:textSize="14sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#D9247BFF"
                app:cardCornerRadius="16dp"
                app:strokeColor="#557EBBFF"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/signlanguage"
                    app:tint="#FFFFFF"/>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- LANGUAGE SELECTOR -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#D9121B3A"
            app:cardCornerRadius="20dp"
            app:strokeColor="#304A6FFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Output language"
                    android:textColor="#9CA9C7"
                    android:textSize="13sp"/>

                <Spinner
                    android:id="@+id/spinnerBridgeLanguage"
                    android:layout_width="145dp"
                    android:layout_height="45dp"
                    android:backgroundTint="#247BFF"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- INPUT CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#D9121B3A"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="#334A6FFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Type your message"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvBridgeCharacterCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/120"
                        android:textColor="#C0C9D8"
                        android:textSize="12sp"/>

                </LinearLayout>


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Example: I need help"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxStrokeColor="#247BFF"
                    app:hintTextColor="#8190AE">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBridgeMessage"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLength="120"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#71809E"
                        android:textSize="16sp"
                        android:padding="16dp"/>

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBridgeGenerate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="Generate Sign  →"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#247BFF"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/signlanguage"
                    app:iconGravity="textStart"
                    app:iconTint="#FFFFFF"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- RESULT -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBridgeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E6101835"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#455B7CFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- RESULT HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Your Bridge"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <ImageButton
                        android:id="@+id/btnBridgeFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/star"
                        app:tint="#FFFFFF"
                        android:contentDescription="Favorite"/>

                </LinearLayout>


                <!-- SIGN MEDIA -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="230dp"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="#07112D"
                    app:cardCornerRadius="22dp"
                    app:strokeColor="#253B68"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivBridgeSign"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:contentDescription="Sign animation"/>

                        <ProgressBar
                            android:id="@+id/progressBridgeMedia"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:indeterminateTint="#247BFF"/>

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- PHRASE -->

                <TextView
                    android:id="@+id/tvBridgePhrase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="I NEED HELP"
                    android:textColor="#FFFFFF"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvBridgeTranslation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="मला मदत हवी आहे"
                    android:textColor="#8FA0C0"
                    android:textSize="16sp"
                    android:gravity="center"/>


                <!-- ACTIONS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBridgeSpeak"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="Listen"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#172A52"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/volume"
                        app:iconTint="#4DA3FF"/>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBridgeShare"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="Share"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#172A52"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/send"
                        app:iconTint="#8B5CF6"/>

                </LinearLayout>


                <!-- OFFLINE BADGE -->

                <TextView
                    android:id="@+id/tvBridgeOffline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:text="● Available Offline"
                    android:textColor="#45E0A8"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- TIP -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Bridge communication. One phrase at a time. 🤟"
            android:textColor="#A0B0C7"
            android:textSize="12sp"
            android:paddingBottom="20dp"/>

    </LinearLayout>

</ScrollView>