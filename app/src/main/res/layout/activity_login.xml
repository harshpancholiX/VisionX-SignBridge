<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Lottie Animation -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lavLoginlottie"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="20dp"
            app:lottie_autoPlay="true"
            app:lottie_rawRes="@raw/translator"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Bridge"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            />

        <!-- Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bridging Silence, Connecting Voices. "
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- CardView -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvLoginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="35dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                >

                <!-- Welcome -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back!"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:fontFamily="sans-serif-medium"
                    />

                <!-- Username -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="Sign in to continue"
                    android:textColor="#64748B"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/etLoginUsername"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="15dp"
                    android:hint="Username"
                    android:textColorHint="@color/black"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:padding="15dp"
                    android:drawableLeft="@drawable/account"
                    android:drawablePadding="8dp"
                    />

                <!-- Password -->
                <EditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="10dp"
                    android:hint="Password"
                    android:textStyle="bold"
                    android:textColorHint="@color/black"
                    android:textColor="@color/black"
                    android:inputType="textPassword"
                    android:padding="15dp"
                    android:drawableLeft="@drawable/lock"
                    android:drawablePadding="8dp"
                    />

                <CheckBox
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/cbLoginShowHidePassword"
                    android:text="Show Password"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginLeft="16sp"
                    android:layout_marginRight="16sp"
                    android:buttonTint="@color/blue"
                    />

                <!-- Forgot Password -->
                <Button
                    android:id="@+id/btnLoginForget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:backgroundTint="@color/white"
                    android:text="Forgot Password?"
                    android:textColor="@color/blue"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    />

                <!-- Login Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnLoginLogin"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="20dp"
                    android:text="LOGIN"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/gradient_button_bg"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:elevation="8dp"
                    />
                <!-- OR Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D3D3D3" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="OR"
                        android:textColor="#808080"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D3D3D3" />

                </LinearLayout>

                <!-- Google Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:text="Google"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/google"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    android:background="?attr/selectableItemBackground"/>

                <!-- Sign Up -->
                <TextView
                    android:id="@+id/tvLoginNewUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="Don't have an account? Sign Up"
                    android:textColor="#64748B"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    />


            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>